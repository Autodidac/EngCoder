+                n_ff_down = w->tensor->ne[0];
+                const int64_t expected = GGML_PAD(n_ff_exp, ggml_blck_size(w->tensor->type));
+                if (n_ff_down != expected) {
+                    throw std::runtime_error(format("unexpected padded Qwen expert down width: got %lld, expected %lld",
+                        (long long) n_ff_down, (long long) expected));
+                }
+            }
+        }
+        layer.ffn_down_exps = create_tensor(tn(LLM_TENSOR_FFN_DOWN_EXPS, "weight", il), { n_ff_down, n_embd, n_expert }, flags);
