{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 4,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-vs2022",
      "displayName": "Windows x64 - Visual Studio 2022",
      "generator": "Visual Studio 17 2022",
      "binaryDir": "${sourceDir}/out/build/windows-vs2022",
      "architecture": "x64",
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/windows-vs2022",
        "THREADSPIRE_AI_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "windows-vs2026",
      "displayName": "Windows x64 - Visual Studio 2026",
      "generator": "Visual Studio 18 2026",
      "binaryDir": "${sourceDir}/out/build/windows-vs2026",
      "architecture": "x64",
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/windows-vs2026",
        "THREADSPIRE_AI_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "linux-ninja",
      "displayName": "Linux Ninja validation",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/linux-ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "THREADSPIRE_AI_BUILD_TESTS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-vs2022-release",
      "configurePreset": "windows-vs2022",
      "configuration": "Release"
    },
    {
      "name": "windows-vs2026-release",
      "configurePreset": "windows-vs2026",
      "configuration": "Release"
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-ninja"
    }
  ],
  "testPresets": [
    {
      "name": "windows-vs2022-release",
      "configurePreset": "windows-vs2022",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "windows-vs2026-release",
      "configurePreset": "windows-vs2026",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-ninja",
      "output": { "outputOnFailure": true }
    }
  ]
}
